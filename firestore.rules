rules_version = '2';
// Daily check-ins: admin-managed bilingual questions; owner-private answers at
// users/{uid}/daily_checkins/{local-YYYY-MM-DD_questionId}. Date boundaries and
// question snapshots are immutable. Client-reported timezone offsets describe
// the user's local day; these self-reports are not an anti-cheating mechanism.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null }

    function activeAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'content_admin', 'moderator'];
    }

    // The six supported resources mirror adminAccess.ts. Provision roles with the Admin SDK.
    function permissionAt(permissions, index, resourceName, action) {
      return permissions.size() > index && permissions[index].resource == resourceName
        && permissions[index].actions is list && action in permissions[index].actions;
    }
    function permitted(resourceName, action) {
      return activeAdmin() && adminPermission(resourceName, action);
    }
    function adminPermission(resourceName, action) {
      let admin = get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
      return (admin.role == 'super_admin' || (admin.permissions is list && (
        permissionAt(admin.permissions, 0, resourceName, action)
        || permissionAt(admin.permissions, 1, resourceName, action)
        || permissionAt(admin.permissions, 2, resourceName, action)
        || permissionAt(admin.permissions, 3, resourceName, action)
        || permissionAt(admin.permissions, 4, resourceName, action)
        || permissionAt(admin.permissions, 5, resourceName, action))));
    }

    // Users — user can manage own; admin can read/write all
    match /users/{userId} {
      allow read: if request.auth.uid == userId || permitted('users', 'read') || permitted('analytics', 'read');
      allow create: if request.auth.uid == userId && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isActive', true) == true;
      allow update: if (request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'deletedAt']))
        || permitted('users', 'update');
      allow delete: if request.auth.uid == userId || permitted('users', 'delete');

      // Devices sub-collection — for FCM tokens (owner only)
      match /devices/{deviceToken} {
        allow read, write: if request.auth.uid == userId;
      }

      // Sessions sub-collection — owner only
      match /sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Logs sub-collection — owner only
      match /logs/{logId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Public editorial quotes; drafts and archives are restricted to content admins.
    function validMotivationQuote(d) {
      return d.keys().hasOnly(['textEn', 'textSi', 'author', 'order', 'status', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.textEn is string && d.textEn.size() <= 1200
        && d.textSi is string && d.textSi.size() <= 1200
        && (d.textEn.matches('(?s).*[^\\s].*') || d.textSi.matches('(?s).*[^\\s].*'))
        && d.author is string && d.author.size() <= 160
        && d.order is int && d.order >= 0 && d.order <= 999
        && d.status in ['draft', 'published', 'archived']
        && d.version is int && d.version >= 1
        && d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /motivation_quotes/{quoteId} {
      allow read: if resource.data.status == 'published' || permitted('content', 'read');
      allow create: if permitted('content', 'create') && validMotivationQuote(request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if permitted('content', 'update') && validMotivationQuote(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    function validCheckinQuestion(d) {
      return d.keys().hasAll(['titleEn', 'titleSi', 'order', 'status', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['titleEn', 'titleSi', 'order', 'status', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.titleEn is string && d.titleEn.size() > 0 && d.titleEn.size() <= 240
        && d.titleSi is string && d.titleSi.size() > 0 && d.titleSi.size() <= 240
        && d.order is int && d.order >= 0 && d.order <= 999
        && d.status in ['draft', 'active', 'archived'] && d.version is int
        && d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /daily_checkin_questions/{questionId} {
      allow read: if (isSignedIn() && resource.data.status == 'active') || permitted('content', 'read');
      allow create: if permitted('content', 'create') && validCheckinQuestion(request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if permitted('content', 'update') && validCheckinQuestion(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    function twoDigits(n) { return (n < 10 ? '0' : '') + string(n); }
    function validCheckinDay(d) {
      let localStart = d.dayStart - duration.value(d.startOffset, 'm');
      let localEnd = d.dayEnd - duration.value(d.endOffset, 'm');
      return d.startOffset is int && d.startOffset >= -840 && d.startOffset <= 720
        && d.endOffset is int && d.endOffset >= -840 && d.endOffset <= 720
        && localStart == localStart.date() && localEnd == localStart + duration.value(1, 'd')
        && d.dayEnd - d.dayStart >= duration.value(22, 'h')
        && d.dayEnd - d.dayStart <= duration.value(26, 'h')
        && d.day == string(localStart.year()) + '-' + twoDigits(localStart.month()) + '-' + twoDigits(localStart.day())
        && request.time >= d.dayStart && request.time < d.dayEnd;
    }
    function validCheckin(d, answerId) {
      let question = get(/databases/$(database)/documents/daily_checkin_questions/$(d.questionId)).data;
      return d.keys().hasAll(['day', 'questionId', 'questionVersion', 'titleEn', 'titleSi', 'answer', 'dayStart', 'dayEnd', 'startOffset', 'endOffset', 'timeZone', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['day', 'questionId', 'questionVersion', 'titleEn', 'titleSi', 'answer', 'dayStart', 'dayEnd', 'startOffset', 'endOffset', 'timeZone', 'createdAt', 'updatedAt'])
        && d.day is string && d.questionId is string && d.answer is bool
        && answerId == d.day + '_' + d.questionId
        && d.timeZone is string && d.timeZone.size() > 0 && d.timeZone.size() <= 100
        && d.dayStart is timestamp && d.dayEnd is timestamp && validCheckinDay(d)
        && question.status == 'active' && d.questionVersion == question.version
        && d.titleEn == question.titleEn && d.titleSi == question.titleSi
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function validCheckinUpdate(d, previous) {
      return d.diff(previous).affectedKeys().hasOnly(['answer', 'updatedAt'])
        && d.answer is bool && d.updatedAt == request.time
        && request.time >= previous.dayStart && request.time < previous.dayEnd;
    }
    // Religious reflections are private, including from administrators.
    match /users/{userId}/daily_checkins/{answerId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && validCheckin(request.resource.data, answerId);
      allow update: if isSignedIn() && request.auth.uid == userId
        && validCheckinUpdate(request.resource.data, resource.data);
    }

    // Favorites (subcollection under users) — owner only
    match /users/{userId}/favorites/{postId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Meditation sessions — owner full control; admin can read for analytics
    match /meditation_sessions/{sessionId} {
      // Idempotent session creation checks a stable ID before writing. Existing
      // documents still require ownership/admin access; list permissions are unchanged.
      allow get: if isSignedIn() && !exists(/databases/$(database)/documents/meditation_sessions/$(sessionId));
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || permitted('analytics', 'read') || permitted('users', 'read')
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Admin users — secure access per-admin
    match /admin_users/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow create, delete: if false;
      allow update: if activeAdmin() && request.auth.uid == adminId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        && request.resource.data.lastLogin == request.time;
    }

    // Kamatahan audio — public read, admin write
    match /kamatahan_audio/{audioId} {
      allow read: if true;
      allow create: if permitted('audio', 'create');
      allow update: if permitted('audio', 'update')
        && request.resource.data.version == resource.data.get('version', 0) + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status in ['active', 'draft', 'inactive', 'archived']
        && (request.resource.data.status == 'active' || request.resource.data.isPublic == false);
      allow delete: if false; // Archive recordings while retaining playlist references.
    }

    // Dhamma posts — public read, admin write
    match /dhamma_posts/{postId} {
      allow read: if resource.data.status == 'published' || permitted('dhamma', 'read') || permitted('analytics', 'read');
      allow create: if permitted('dhamma', 'create') && validPost()
        && request.resource.data.get('version', 0) == 0;
      allow update: if permitted('dhamma', 'update') && validPost()
        && request.resource.data.version == resource.data.get('version', 0) + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/dhamma_posts/$(postId)/revisions/$(string(request.resource.data.version))).data.snapshot == resource.data;
      allow delete: if false; // Keep articles and revision history recoverable.
      function validPost() {
        return request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.content is string
          && request.resource.data.status in ['draft', 'published', 'archived'];
      }
      match /revisions/{revisionId} {
        allow read: if permitted('dhamma', 'read');
        allow create: if permitted('dhamma', 'update') && validRevision();
        allow update, delete: if false;
        function validRevision() {
          let before = get(/databases/$(database)/documents/dhamma_posts/$(postId)).data;
          let after = getAfter(/databases/$(database)/documents/dhamma_posts/$(postId)).data;
          let revision = request.resource.data;
          return revision.keys().hasOnly(['version', 'snapshot', 'actorId', 'createdAt', 'action'])
            && revision.version == before.get('version', 0) + 1
            && revisionId == string(revision.version)
            && revision.snapshot == before
            && revision.actorId == request.auth.uid
            && revision.createdAt == request.time
            && revision.action in ['update', 'archive', 'restore']
            && after.version == revision.version
            && after.updatedBy == request.auth.uid;
        }
      }
    }


    // Learning schemas: bilingual display text only (no private teacher contacts).
    // Teachers: name/nameEn <=160, bio/bioEn <=5000, status + editorial metadata.
    // Paths: title/titleEn <=180, description/descriptionEn <=3000, topic/level/language,
    // optional teacherId, <=12 unique ordered lessonIds (article_ID or audio_ID).
    // Metadata: immutable createdAt/createdBy; server updatedAt/current actor; integer version.
    function learningString(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function learningMetadata(data) {
      return data.status in ['draft', 'published', 'archived']
        && data.version is int && data.version >= 0 && data.version <= 2147483647
        && data.createdAt is timestamp && learningString(data.createdBy, 1, 128)
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    function learningCreate(data) {
      return data.version == 0 && data.createdAt == request.time && data.createdBy == request.auth.uid;
    }
    function learningUpdate(data) {
      return data.version == resource.data.version + 1
        && data.createdAt == resource.data.createdAt && data.createdBy == resource.data.createdBy;
    }
    function validTeacher(data) {
      return data.keys().hasOnly(['name','nameEn','bio','bioEn','status','version','createdAt','createdBy','updatedAt','updatedBy'])
        && learningString(data.name, 1, 160) && learningString(data.nameEn, 0, 160)
        && learningString(data.bio, data.status == 'published' ? 1 : 0, 5000)
        && learningString(data.bioEn, 0, 5000) && learningMetadata(data);
    }
    function lessonAt(ids, index) {
      return ids.size() <= index || (ids[index] is string && ids[index].matches('^(article|audio|pdf)_[A-Za-z0-9_-]{1,128}$'));
    }
    function validLearningPath(data) {
      return data.keys().hasOnly(['title','titleEn','description','descriptionEn','teacherId','topic','level','language','status','lessonIds','version','createdAt','createdBy','updatedAt','updatedBy'])
        && learningString(data.title, 1, 180) && learningString(data.titleEn, 0, 180)
        && learningString(data.description, data.status == 'published' ? 1 : 0, 3000)
        && learningString(data.descriptionEn, 0, 3000)
        && data.teacherId is string && (data.teacherId == '' || data.teacherId.matches('^[A-Za-z0-9_-]{1,128}$'))
        && data.topic in ['meditation','dhamma','daily_practice','sutta','ethics']
        && data.level in ['beginner','intermediate','advanced'] && data.language in ['si','en','mixed']
        && learningMetadata(data)
        && data.lessonIds is list && data.lessonIds.size() <= 12
        && (data.status != 'published' || data.lessonIds.size() > 0)
        && data.lessonIds.toSet().size() == data.lessonIds.size()
        && lessonAt(data.lessonIds, 0)
        && lessonAt(data.lessonIds, 1)
        && lessonAt(data.lessonIds, 2)
        && lessonAt(data.lessonIds, 3)
        && lessonAt(data.lessonIds, 4)
        && lessonAt(data.lessonIds, 5)
        && lessonAt(data.lessonIds, 6)
        && lessonAt(data.lessonIds, 7)
        && lessonAt(data.lessonIds, 8)
        && lessonAt(data.lessonIds, 9)
        && lessonAt(data.lessonIds, 10)
        && lessonAt(data.lessonIds, 11);
    }
    function validPresentation(data, presentationId) {
      return data.keys().hasOnly(['title','titleEn','description','descriptionEn','objectives','objectivesEn','teacherId','language','minutes','allowDownload','status','storagePath','fileName','fileSize','pageCount','version','createdAt','createdBy','updatedAt','updatedBy'])
        && learningMetadata(data)
        && learningString(data.title, 1, 180) && learningString(data.titleEn, 0, 180)
        && learningString(data.description, data.status == 'published' ? 1 : 0, 3000)
        && learningString(data.descriptionEn, 0, 3000)
        && learningString(data.objectives, 0, 3000) && learningString(data.objectivesEn, 0, 3000)
        && data.teacherId is string && (data.teacherId == '' || data.teacherId.matches('^[A-Za-z0-9_-]{1,128}$'))
        && data.language in ['si','en','mixed']
        && data.minutes is int && data.minutes >= 1 && data.minutes <= 600
        && data.allowDownload is bool && learningString(data.fileName, 0, 255)
        && data.pageCount is int && data.fileSize is int && data.storagePath is string
        && ((data.storagePath == '' && data.status != 'published' && data.fileSize == 0 && data.pageCount == 0 && data.fileName == '')
          || (data.storagePath.matches('^presentations/' + presentationId + '/[A-Za-z0-9_-]+[.]pdf$')
            && data.fileSize > 0 && data.fileSize <= 26214400 && data.pageCount > 0 && data.pageCount <= 2000 && data.fileName.size() > 0));
    }
    match /learning_presentations/{presentationId} {
      allow read: if (isSignedIn() && resource.data.status == 'published') || permitted('content', 'read');
      allow create: if permitted('content', 'create') && validPresentation(request.resource.data, presentationId) && learningCreate(request.resource.data);
      allow update: if permitted('content', 'update') && validPresentation(request.resource.data, presentationId) && learningUpdate(request.resource.data);
      allow delete: if false;
    }
    match /users/{userId}/learning_reading/{presentationId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && validReading(request.resource.data);
      function validReading(data) {
        let presentation = get(/databases/$(database)/documents/learning_presentations/$(presentationId)).data;
        let path = get(/databases/$(database)/documents/learning_paths/$(data.pathId)).data;
        return data.keys().hasOnly(['page','storagePath','pathId','updatedAt'])
          && presentation.status == 'published' && path.status == 'published'
          && ('pdf_' + presentationId) in path.lessonIds
          && data.storagePath == presentation.storagePath
          && data.page is int && data.page >= 1 && data.page <= presentation.pageCount
          && data.updatedAt == request.time;
      }
    }
    match /teachers/{teacherId} {
      allow read: if (isSignedIn() && resource.data.status == 'published') || permitted('content', 'read');
      allow create: if permitted('content', 'create') && validTeacher(request.resource.data) && learningCreate(request.resource.data);
      allow update: if permitted('content', 'update') && validTeacher(request.resource.data) && learningUpdate(request.resource.data);
      allow delete: if false;
    }
    match /learning_paths/{pathId} {
      allow read: if (isSignedIn() && resource.data.status == 'published') || permitted('content', 'read');
      allow create: if permitted('content', 'create') && validLearningPath(request.resource.data) && learningCreate(request.resource.data);
      allow update: if permitted('content', 'update') && validLearningPath(request.resource.data) && learningUpdate(request.resource.data);
      allow delete: if false;
    }
    // Private personal checklist. It does not measure spiritual attainment or verified listening.
    match /users/{userId}/learning_progress/{pathId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && validLearningProgress(request.resource.data);
      function validLearningProgress(data) {
        let path = get(/databases/$(database)/documents/learning_paths/$(pathId)).data;
        return path.status == 'published' && data.keys().hasOnly(['completedIds','updatedAt'])
          && data.updatedAt == request.time && data.completedIds is list && data.completedIds.size() <= 12
          && data.completedIds.toSet().size() == data.completedIds.size() && data.completedIds.hasOnly(path.lessonIds);
      }
    }

    // Playlists — public read for isPublic; owner/admin manage
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true
        || (isSignedIn() && (resource.data.userId == request.auth.uid || permitted('audio', 'read')));
      allow create: if validPlaylistVisibility() && isSignedIn() && (
        request.resource.data.userId == request.auth.uid || permitted('audio', 'create')
      );
      allow update: if validPlaylistVisibility() && validPlaylistVersion() && isSignedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || permitted('audio', 'update')
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || permitted('audio', 'delete'));
      function validPlaylistVisibility() {
        return request.resource.data.get('archived', false) != true || request.resource.data.isPublic == false;
      }
      function validPlaylistVersion() {
        // Personal playlists created by older clients can continue using their existing format.
        return (!('version' in resource.data) && !('version' in request.resource.data))
          || request.resource.data.version == resource.data.get('version', 0) + 1;
      }
    }

    // Audio listens (for counts)
    match /audio_listens/{listenId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.audioId is string && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Dhamma reads (per-user tracking)
    match /dhamma_reads/{readId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Translations — public read, admin write
    match /translations/{docId} {
      allow read: if true;
      allow create: if permitted('settings', 'create');
      allow update: if permitted('settings', 'update');
      allow delete: if permitted('settings', 'delete');
    }

    // Meditation types — public read, admin write
    match /meditation_types/{typeId} {
      allow read: if true;
      allow create: if permitted('content', 'create');
      allow update: if permitted('content', 'update');
      allow delete: if permitted('content', 'delete');
    }

    // Meditation categories — public read, admin write (NEW)
    match /meditationCategories/{categoryId} {
      allow read: if true;
      allow create: if permitted('content', 'create');
      allow update: if permitted('content', 'update');
      allow delete: if permitted('content', 'delete');
    }

    // App settings (theme, etc.) — public read, admin write
    match /app_settings/{docId} {
      allow read: if true;
      allow create: if permitted('settings', 'create');
      allow update: if permitted('settings', 'update');
      allow delete: if permitted('settings', 'delete');
    }

    // Meditation Events — signed-in readers, admin writes (preserves deployed visibility).
    match /meditation_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if permitted('content', 'create') && validEvent();
      allow update: if permitted('content', 'update') && validEvent();
      allow delete: if permitted('content', 'delete');
      function validEvent() {
        return request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.startDate is timestamp && request.resource.data.endDate is timestamp
          && request.resource.data.endDate >= request.resource.data.startDate
          && request.resource.data.isActive is bool;
      }
    }

    // Event Participation — owner writes, signed-in reads for event statistics.
    match /event_participation/{participationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if false; // Prevent accidental deletion of history
    }
  }
}
